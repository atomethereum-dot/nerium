# Copia este archivo a .env y rellénalo. .env NO se sube al repositorio.

# La clave privada de la cuenta que despliega. Sin el 0x delante.
# Usa una cuenta nueva, solo con el gas justo para desplegar.
CLAVE_PRIVADA=

# RPC de cada red. Alchemy, Infura, QuickNode o el público de la red.
RPC_ETHEREUM=
RPC_BSC=
# Robinhood Chain (4663). Si se deja vacio se usa el publico de la red.
RPC_ROBINHOOD=

# Para verificar el código en el explorador. Opcional pero muy recomendable:
# sin esto tu contrato sale sin código fuente y nadie se fía.
API_ETHERSCAN=
API_BSCSCAN=
# Robinhood Chain verifica en Blockscout, que no pide clave.

# ── Robinhood Chain: las dos direcciones que faltan por confirmar ──
# El USDT de la red y el oraculo ETH/USD de Chainlink en la cadena 4663.
# NO van escritas en el codigo a proposito: una direccion de oraculo
# equivocada no se nota a ojo y arruina la ronda entera. El script las
# interroga en cadena antes de gastar gas y aborta si no cuadran.
USDT_ROBINHOOD=
ORACULO_ETH_USD_ROBINHOOD=
