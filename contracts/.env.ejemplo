# Copia este archivo a .env y rellénalo. .env NO se sube al repositorio.

# La clave privada de la cuenta que despliega. Sin el 0x delante.
# Usa una cuenta nueva, solo con el gas justo para desplegar.
CLAVE_PRIVADA=

# RPC de cada red. Alchemy, Infura, QuickNode o el público de la red.
RPC_ETHEREUM=
RPC_BSC=

# Para verificar el código en el explorador. Opcional pero muy recomendable:
# sin esto tu contrato sale sin código fuente y nadie se fía.
API_ETHERSCAN=
API_BSCSCAN=
